<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg_01">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_glyph" android:layout_width="38dp" android:layout_height="38dp" android:gravity="center" android:text="✦" android:textSize="23sp" android:textStyle="bold" android:background="#201C2D" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/widget_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HAZIR" android:textColor="#B39BFF" android:textSize="9sp" android:fontFamily="monospace" android:letterSpacing="0.08" />
            <TextView android:id="@+id/widget_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Kairo hazır" android:textColor="#F3F3F8" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↗" android:textColor="#88899A" android:textSize="17sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_model" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="GEMINI · API BAĞLANMADI" android:textColor="#9699A8" android:textSize="8sp" android:fontFamily="monospace" android:letterSpacing="0.06" />
</LinearLayout>
